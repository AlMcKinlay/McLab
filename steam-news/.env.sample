# Steam News Configuration
# Copy this file to .env and fill in your actual values

# Public URL of the aggregated feed. The service PUTs the generated XML here
# and the RSS reader subscribes to it. Served by functions/steam-news.js.
FEED_URL=https://your-site.netlify.app/steam-news.xml

# Shared secret that authorises pushes to FEED_URL. Set the same value as
# STEAM_NEWS_PUSH_SECRET in the Netlify site's environment variables.
# Generate one with: openssl rand -hex 32
FEED_PUSH_SECRET=

# Optional: extra App IDs to include even if not followed, comma-separated.
# With no refresh token on disk, only these apps are used.
STEAM_EXTRA_APP_IDS=

# Optional: Telegram alerts when auth or publishing breaks. Uses the same bot
# token as telegram-bot. TELEGRAM_ADMIN_CHAT_ID is your private chat with the
# bot: message the bot directly once and read the chat ID from its logs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Optional tuning (defaults shown)
# POLL_INTERVAL_MINUTES=30
# MAX_FEED_ITEMS=500
# MAX_STORED_ITEMS=1500
# NEW_APP_ITEM_LIMIT=3
# FEED_CONCURRENCY=5
# STEAM_NEWS_DATA_DIR=./data
