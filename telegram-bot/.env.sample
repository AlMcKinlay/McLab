# Telegram Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Telegram bot token from BotFather
# Get this from: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_token_here

# Your Notion API token
# Get this from: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_your_token_here

TELEGRAM_GROUP_CHAT_ID=your_group_chat_id_here
# Data source ID of the Nathan Tracker database in Notion
# Printed by: node --env-file=.env scripts/migrate-tracker-to-database.mjs
NOTION_TRACKER_DATA_SOURCE_ID=

# Optional: push statuses to Home Assistant (both required to enable)
# URL as reachable from the bot, e.g. http://homeassistant.local:8123
# Token: Home Assistant profile > Security > Long-lived access tokens
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
